# -----------------------------------------------------------------------
# Discord Bot  (docker compose で使用する変数)
# compose.yaml の discord-bot サービスが参照する
# -----------------------------------------------------------------------

# Discord bot token (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your-discord-bot-token

# Discord server (guild) IDs — comma-separated
DISCORD_GUILD_IDS=123456789012345678

# Workspace ID used as Firestore namespace (default: default)
# WORKSPACE_ID=default

# -----------------------------------------------------------------------
# Google API  (act-adk-worker / organize サービスが参照する)
# -----------------------------------------------------------------------

# Google Gemini API key (https://ai.google.dev/)
GOOGLE_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------
# 注: GCS_BUCKET / GOOGLE_CLOUD_PROJECT / PUBSUB_* などは
#     compose.yaml 内でエミュレータ向けの値がハードコードされており
#     .env への記載は不要です。
# -----------------------------------------------------------------------
